# Computer C: copy to .env and fill in. Never commit .env.

# Shared secret between Computer C and the PC. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
EMBED_API_KEY=CHANGE_ME

# Model. Do not change after the first real run: vectors of different models,
# revisions or quantisations must never be mixed.
EMBED_MODEL=Qwen/Qwen3-VL-Embedding-8B
EMBED_MODEL_REVISION=
EMBED_QUANT=int8
EMBED_DIM=1024

# Images per GPU step. Lower to 2 or 1 if you get "CUDA out of memory".
EMBED_BATCH_SIZE=4
# Max pixels per image after resizing (reference default 1800*32*32).
EMBED_MAX_PIXELS=1843200

# 1 = no model, random vectors: only to test Tailscale, firewall and API key.
EMBED_FAKE=0

# Where Hugging Face stores the downloaded model (~17 GB).
HF_HOME=C:\hf-cache
